# =============================================================================
# DigitalWerk Agent API + Postgres — deploy config for the Hetzner CX23.
# Copy to `.env` in this directory, `chmod 600 .env`. This file is the ONLY
# place real secrets live on the server. `.env` is gitignored.
# =============================================================================

# --- image tag (set to the built commit SHA for a traceable deploy) ---------
AGENT_IMAGE_TAG=local

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=digitalwerk
POSTGRES_USER=digitalwerk
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- LLM gateway (OmniRoute — or any OpenAI-compatible endpoint) -----------
# LLM_PROVIDER is a free-text label. Anything other than "mock" / "anthropic"
# is treated as an openai-compatible gateway. Leave as "mock" until the
# OmniRoute credentials below are filled in — the agent then runs on the
# deterministic mock provider (fully functional, no cost).
LLM_PROVIDER=mock
# OmniRoute chat-completions base (…/v1). e.g. https://<your-omniroute-host>/v1
LLM_BASE_URL=
# OmniRoute API key — SERVER-SIDE ONLY. Never a NEXT_PUBLIC_ / client var.
LLM_API_KEY=
# Model id passed through verbatim, e.g. "cc/claude-sonnet-4-6" or "openai/gpt-4o-mini".
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# --- request auth (the Vercel /api/chat proxy sends this as X-Agent-Auth) --
# Generate: openssl rand -hex 32
AGENT_API_SECRET=
AGENT_API_ALLOWED_ORIGINS=https://www.digitalwerkk.de,https://digitalwerkk.de
CHAT_AGENT_RATE_LIMIT_PER_MINUTE=20

# --- admin API + maintenance cron ---------------------------------------
# Guards GET /api/chat/admin/* . Unset -> those endpoints return 503.
# Generate: openssl rand -hex 24
CHAT_AGENT_ADMIN_TOKEN=
# Bearer the maintenance timer sends to /api/cron/purge-transcripts.
CRON_SECRET=

# --- notifications (Resend) --------------------------------------------
# "resend" + RESEND_API_KEY activates email; otherwise handoffs are recorded
# and queued but not sent.
CHAT_AGENT_HANDOFF_CHANNEL=
RESEND_API_KEY=
CHAT_AGENT_NOTIFY_TO=info@digitalwerkk.de
CHAT_AGENT_NOTIFY_FROM=onboarding@resend.dev

# --- retention (privacy) — hard-capped at 30 regardless ----------------
CHAT_AGENT_TRANSCRIPT_RETENTION_DAYS=30
CHAT_AGENT_EVENT_RETENTION_DAYS=30

TZ=Europe/Berlin

# --- off-server backup destination (see backup.sh) --------------------
# rclone remote:path for the nightly pg_dump. Leave empty to keep local-only
# backups (NOT sufficient for production — see README "Backups").
BACKUP_RCLONE_REMOTE=
# Optional dead-man's-switch (e.g. healthchecks.io ping URL).
BACKUP_HEALTHCHECK_URL=
