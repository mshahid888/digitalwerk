[Unit]
Description=DigitalWerk agent maintenance (retention purge + handoff retry)
After=docker.service

[Service]
Type=oneshot
User=deploy
# CRON_SECRET must match deploy/digitalwerk/.env . Pass it via an
# EnvironmentFile or edit inline. The agent-api is reachable on the
# digitalwerk_edge network from the host via the container name / a
# published-to-loopback mapping — simplest is to curl through Caddy:
#   https://agent.digitalwerkk.de/api/cron/purge-transcripts
ExecStart=/usr/bin/curl -fsS -m 60 -X POST \
  -H "Authorization: Bearer ${CRON_SECRET}" \
  https://agent.digitalwerkk.de/api/cron/purge-transcripts
EnvironmentFile=/opt/apps/digitalwerk/digitalwerk/deploy/digitalwerk/.env
