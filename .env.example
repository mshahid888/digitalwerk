# Copy this file to .env.local and fill in real values as they become
# available. Never commit .env.local or any file with real secrets —
# .gitignore already excludes .env* (this file is explicitly un-ignored).
# Every variable below is optional: the site builds and runs normally
# with none of them set.

# --- Production domain ---------------------------------------------------
# Overrides the placeholder domain in lib/site-config.ts once assigned.
NEXT_PUBLIC_SITE_URL=

# --- Contact form email delivery (server-side, optional) -----------------
# Without RESEND_API_KEY, the contact form automatically falls back to its
# current mailto: behavior — nothing breaks if these are left empty.
# See app/api/kontakt/route.ts and components/kontakt/contact-form.tsx.
RESEND_API_KEY=
# Defaults to siteConfig.contact.email if unset.
CONTACT_TO_EMAIL=
# Must be an address on a domain verified with Resend. Resend's shared
# onboarding@resend.dev sender works without domain verification for
# initial testing; app/api/kontakt/route.ts falls back to it if unset.
CONTACT_FROM_EMAIL=

# --- Chat agent LLM provider (server-side, provider-agnostic) ------------
# The agent runs fully with NONE of these set, on a deterministic mock
# provider (no cost, no network). Provider selection is configuration only —
# the agent code never imports a vendor SDK.
#
# LLM_PROVIDER: a label. "mock" or "anthropic" pick those adapters; ANY
# other value ("omniroute", "openai", "groq", …) selects the generic
# OpenAI-compatible HTTP adapter. Production default: OmniRoute.
LLM_PROVIDER=
# OpenAI-compatible chat-completions base URL, ending in /v1
# (OmniRoute: https://<your-omniroute-host>/v1).
LLM_BASE_URL=
# API key for the gateway. SERVER-SIDE ONLY — never a NEXT_PUBLIC_ variable.
LLM_API_KEY=
# Model id, passed through verbatim (e.g. "cc/claude-sonnet-4-6", "openai/gpt-4o-mini").
LLM_MODEL=
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=
LLM_TEMPERATURE=
LLM_MAX_OUTPUT_TOKENS=
#
# Optional direct Anthropic adapter (kept as a clean fallback provider; not
# the production path). Set LLM_PROVIDER=anthropic + a key to use it.
ANTHROPIC_API_KEY=
#
# Legacy aliases still honoured (LLM_* wins): CHAT_AGENT_PROVIDER,
# CHAT_AGENT_MODEL, CHAT_AGENT_TEMPERATURE, CHAT_AGENT_MAX_OUTPUT_TOKENS.
CHAT_AGENT_MAX_INPUT_CHARS=
CHAT_AGENT_MAX_MESSAGES_PER_SESSION=
CHAT_AGENT_MAX_HISTORY_TURNS=

# --- Agent API split: frontend on Vercel, agent backend on Hetzner ------
# When AGENT_API_URL is set, the Vercel /api/chat/* routes proxy to the
# Hetzner Agent API (which fronts the private Postgres) instead of running
# the agent in-process. The browser always calls Vercel same-origin; it
# never sees this URL or the secret.
AGENT_API_URL=
# Shared secret sent as X-Agent-Auth on proxied requests. Set the SAME value
# on the Hetzner side (deploy/digitalwerk/.env). Server-side only.
AGENT_API_SECRET=
# CORS allow-list for the standalone Agent API (comma-separated).
AGENT_API_ALLOWED_ORIGINS=
# Lightweight per-IP rate limit for the Agent API (requests/minute).
CHAT_AGENT_RATE_LIMIT_PER_MINUTE=

# --- Chat agent persistence (server-side, optional) ----------------------
# Unset -> in-memory store (dev / preview; data is not durable).
# Set a Postgres connection string to persist leads, handoffs, session
# metadata and summaries. The intended production database is a self-hosted
# Postgres on the existing Hetzner server (deploy/digitalwerk/), reached
# only from the Hetzner Agent API over the private Docker network — NOT
# exposed to Vercel. CHAT_AGENT_DATABASE_URL takes precedence; DATABASE_URL
# / POSTGRES_URL / POSTGRES_PRISMA_URL are also accepted.
# The schema is created automatically on first use (CREATE TABLE IF NOT EXISTS);
# lib/chat-agent/persistence/postgres/schema.sql is the reference DDL.
CHAT_AGENT_DATABASE_URL=

# --- Chat agent retention / privacy ------------------------------------
# Days to keep raw conversation transcripts and raw analytics events before
# automatic deletion. Both default to 30 and are HARD-CAPPED at 30. The
# permanent lead record is unaffected. This is the single place retention
# is configured.
CHAT_AGENT_TRANSCRIPT_RETENTION_DAYS=
CHAT_AGENT_EVENT_RETENTION_DAYS=

# --- Chat agent handoff / lead notifications (server-side, optional) -----
# Notification channel. Unset -> handoffs & leads are recorded durably but
# no email is sent (they queue for later delivery). "resend" activates the
# email channel, but only when RESEND_API_KEY (above) is also set — otherwise
# it stays a safe no-op.
CHAT_AGENT_HANDOFF_CHANNEL=
# Recipient / sender for handoff + lead emails (default: CONTACT_TO_EMAIL /
# CONTACT_FROM_EMAIL, then info@digitalwerkk.de / onboarding@resend.dev).
CHAT_AGENT_NOTIFY_TO=
CHAT_AGENT_NOTIFY_FROM=
# Max delivery attempts before a notification is left for manual follow-up.
CHAT_AGENT_NOTIFY_MAX_ATTEMPTS=

# --- Chat agent admin API (server-side, optional) ----------------------
# Bearer token guarding GET /api/chat/admin/leads, /handoffs and POST
# /api/chat/admin/purge. Unset -> those endpoints return 503 (disabled).
CHAT_AGENT_ADMIN_TOKEN=
# Secret Vercel Cron sends in the Authorization header for the daily
# maintenance job (/api/cron/purge-transcripts). Set this in production.
CRON_SECRET=

# --- Analytics / tracking (client-side, optional) -------------------------
# Each integration only loads if its ID is set — see
# components/analytics/analytics.tsx. Leave empty until you have real,
# confirmed account IDs.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
