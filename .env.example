# Copy this file to .env.local and fill in real values as they become
# available. Never commit .env.local or any file with real secrets —
# .gitignore already excludes .env* (this file is explicitly un-ignored).
# Every variable below is optional: the site builds and runs normally
# with none of them set.

# --- Production domain ---------------------------------------------------
# Overrides the placeholder domain in lib/site-config.ts once assigned.
NEXT_PUBLIC_SITE_URL=

# --- Contact form email delivery (server-side, optional) -----------------
# Without RESEND_API_KEY, the contact form automatically falls back to its
# current mailto: behavior — nothing breaks if these are left empty.
# See app/api/kontakt/route.ts and components/kontakt/contact-form.tsx.
RESEND_API_KEY=
# Defaults to siteConfig.contact.email if unset.
CONTACT_TO_EMAIL=
# Must be an address on a domain verified with Resend. Resend's shared
# onboarding@resend.dev sender works without domain verification for
# initial testing; app/api/kontakt/route.ts falls back to it if unset.
CONTACT_FROM_EMAIL=

# --- Chat agent (server-side, all optional) ------------------------------
# The chat agent runs fully without any of these using a deterministic mock
# LLM provider — see lib/chat-agent and docs/CHAT-AGENT/. Set a real key
# only when moving past mock development (that incurs Anthropic usage cost).
#
# "mock" (default) or "anthropic". Falls back to "mock" if no key is set.
CHAT_AGENT_PROVIDER=
# Only read when the provider is "anthropic". Never commit a real key.
ANTHROPIC_API_KEY=
# Model id override (default: claude-sonnet-5 for anthropic, mock-1 for mock).
CHAT_AGENT_MODEL=
# Tuning (all have safe defaults):
CHAT_AGENT_TEMPERATURE=
CHAT_AGENT_MAX_OUTPUT_TOKENS=
CHAT_AGENT_MAX_INPUT_CHARS=
CHAT_AGENT_MAX_MESSAGES_PER_SESSION=
CHAT_AGENT_MAX_HISTORY_TURNS=
# Handoff notification channel (e.g. "email", "slack"). Unset = handoffs are
# recorded but not dispatched anywhere yet.
CHAT_AGENT_HANDOFF_CHANNEL=

# --- Analytics / tracking (client-side, optional) -------------------------
# Each integration only loads if its ID is set — see
# components/analytics/analytics.tsx. Leave empty until you have real,
# confirmed account IDs.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
